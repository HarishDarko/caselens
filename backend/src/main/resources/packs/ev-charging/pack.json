    { "id": "CHARGER_SITE_OUTAGE", "guidance": "Identify affected site scope and escalate operational impact." },
    { "id": "CONNECTOR_FAULT", "guidance": "Isolate connector-specific faults and check alternate connector availability." },
    { "id": "OCPP_CONNECTIVITY", "guidance": "Verify heartbeat, last-seen timestamp, and network path." },
