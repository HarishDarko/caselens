CASELENS_AI_PROVIDER=mock
SPRING_PROFILES_ACTIVE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1/interactions
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
CASELENS_DEMO_PASSCODE=change-me
CASELENS_SESSION_SECRET=replace-with-at-least-32-random-characters
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/caselens
SPRING_DATASOURCE_USERNAME=caselens
SPRING_DATASOURCE_PASSWORD=caselens

# Deployment-only Neon credentials copied into AWS Secrets Manager.
# Keep real values in the ignored .env.neon file, never in this example.
NEON_JDBC_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
NEON_USERNAME=<neon-role>
NEON_PASSWORD=<neon-password>
AWS_REGION=ca-central-1
AWS_ENDPOINT_URL=http://localhost:4566
CASELENS_TRIAGE_QUEUE_URL=http://localhost:4566/000000000000/caselens-triage
CASELENS_QUEUE_ENABLED=true
CASELENS_RUNTIME_ENVIRONMENT=local-review
CASELENS_RUNTIME_DATABASE=postgresql
CASELENS_RUNTIME_QUEUE=localstack-sqs
CASELENS_RUNTIME_AI_PROVIDER=deterministic
